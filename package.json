{
  "name": "ultimate-celestial-vocab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/study-loop.mjs",
    "dev": "vite",
    "build": "node tools/generate_version.js && vite build",
    "verify": "node tools/verify_performance_lifecycle.mjs && node tools/verify_version_system.mjs",
    "lint": "eslint src tools tests vite.config.js eslint.config.js",
    "lint:fix": "eslint src tools tests vite.config.js eslint.config.js --fix",
    "format": "prettier --write \"tests/ui-*.test.mjs\" \"tests/card-*.test.mjs\" \"tests/badge-tab-*.test.mjs\" \"tests/p0-*.test.mjs\" \"tests/p1-*.test.mjs\" \"tests/p2-*.test.mjs\" \"tests/p4-*.test.mjs\" \"tests/p5-*.test.mjs\" \"tests/p6-*.test.mjs\" \"tests/p7-*.test.mjs\" \"eslint.config.js\" \".prettierrc.json\"",
    "format:check": "prettier --check \"tests/ui-*.test.mjs\" \"tests/card-*.test.mjs\" \"tests/badge-tab-*.test.mjs\" \"tests/p0-*.test.mjs\" \"tests/p1-*.test.mjs\" \"tests/p2-*.test.mjs\" \"tests/p4-*.test.mjs\" \"tests/p5-*.test.mjs\" \"tests/p6-*.test.mjs\" \"tests/p7-*.test.mjs\" \"eslint.config.js\" \".prettierrc.json\"",
    "budget": "node tools/bundle_budget.mjs",
    "report": "node tools/render_report.mjs",
    "changelog": "node tools/changelog.mjs",
    "preview": "vite preview",
    "train": "node tools/train_fsrs7.js",
    "version": "node tools/generate_version.js",
    "icons": "node tools/build-icon-subset.mjs",
    "check": "npm run lint && npm test && npm run build && npm run budget && npm run test:e2e"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "animejs": "^3.2.1",
    "firebase": "10.14.1",
    "idb": "^8.0.3"
  }
}
